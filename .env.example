# Base URL of the Express API (doctor-tracker-backend). The /api/* proxy route forwards requests here.
# Read at runtime by src/app/api/[...path]/route.ts.
API_URL=http://localhost:4000

# Must be the SAME value as JWT_SECRET in the backend's .env.
# middleware.ts uses it to verify the session token's signature before rendering any page.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Optional. Must match PROXY_SECRET in the backend. Lets the proxy forward visitors' real IPs
# (for the API's login rate limiter). Leave empty for local development.
PROXY_SECRET=
