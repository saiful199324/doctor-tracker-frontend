# Base URL of the Express API (server/). Requests to /api/* are proxied here.
# Read at build/start time by next.config.ts.
API_URL=http://localhost:4000

# Must be the SAME value as JWT_SECRET in server/.env.
# middleware.ts uses it to verify the session token's signature before rendering any page.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
